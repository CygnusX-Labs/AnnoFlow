# =============================================================================
# AnnoFlow .gitignore
# =============================================================================

# Snakemake 运行状态
.snakemake/

# 日志与基准（§1.3 命名规范 logs/<NN>.<module>/、benchmarks/<NN>.<module>/）
logs/
benchmarks/
*.log

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 编辑器与系统
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# 环境变量文件（含敏感信息，如 API key）
.env
.env.local
.env.*.local

# 注释数据库（大型数据集，经 reference.yaml 指向仓库外）
dataset/

# 真实运行目录与交付产物
runs/
results/
tmp/

# 样本输出目录（workflow 目录下按步骤编号的结果）
*/eggnog/
*/kofam/
merged/

# test/ 目录下测试生成的产物（测试输入如 test/*.pep 必须保留并提交）
test/*.tsv
test/*_highconf.tsv
test/*_multi_KO_genes.tsv
test/*_report.txt
test/*.emapper.*
test/*.ko
test/*.ko_annotation*
test/temp/
test/.python-version
test/*.log

# 交付目录
02.data_deliver/
